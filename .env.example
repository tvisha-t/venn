# --- Database (Supabase Postgres with the `vector` extension enabled) ---
# Use the Session pooler connection string from Project Settings → Database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # default
# VOYAGE_API_KEY=                           # optional: better semantic search (1024-dim); local embedder used otherwise

# --- Email ---
EMAIL_MODE=sandbox                          # sandbox → /dev/inbox; live → Postmark
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_DOMAIN=
REPLY_DOMAIN=
INBOUND_WEBHOOK_SECRET=                     # openssl rand -hex 32
# FEATURE_AA_COBRAND=false                  # "Sent via the GT Alumni Association" line

# --- Security ---
LINK_SIGNING_SECRET=                        # openssl rand -hex 32 (required in production)
CRON_SECRET=                                # protects /api/cron/tick in production

# --- App ---
APP_URL=http://localhost:3000
APP_NAME=Venn
MAPBOX_TOKEN=                               # unused: map uses MapLibre + OpenFreeMap (no token)
