# --- Database (Supabase Postgres with the `vector` extension enabled) ---
# Use the Session pooler connection string from Project Settings → Database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # default
# VOYAGE_API_KEY=                           # optional: better semantic search (1024-dim); local embedder used otherwise

# --- Email ---
EMAIL_MODE=sandbox                          # sandbox → /dev/inbox; live → Postmark
EMAIL_PROVIDER=postmark                     # postmark | gmail (demo: send through a Gmail account, no domain needed)
GMAIL_USER=                                 # EMAIL_PROVIDER=gmail: the sending Gmail address
GMAIL_APP_PASSWORD=                         # EMAIL_PROVIDER=gmail: app password (needs 2-Step Verification on)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_DOMAIN=
REPLY_DOMAIN=
INBOUND_WEBHOOK_SECRET=                     # openssl rand -hex 32
POSTMARK_INBOUND_ADDRESS=                   # <hash>@inbound.postmarkapp.com (Postmark Inbound stream). Webhook URL: https://<app>/api/email/inbound?token=<INBOUND_WEBHOOK_SECRET>
EMAIL_SANDBOX_ALLOWLIST=                    # sandbox mode: comma-separated addresses that ALSO get real email
DEMO_INBOX_EMAIL=                           # real inbox that receives mail addressed to fictional demo people (.test / example.* domains)
# SANDBOX_SHOW_SIGNIN_CODES=false           # show sign-in code emails in /dev/inbox (default: on in dev, off in production)
# ALLOW_DEMO_LOGIN=true                     # "Continue with school login" demo picker (fictional identities)
# FEATURE_AA_COBRAND=false                  # "Sent via the GT Alumni Association" line

# --- Security ---
LINK_SIGNING_SECRET=                        # openssl rand -hex 32 (required in production)
CRON_SECRET=                                # protects /api/cron/tick in production

# --- App ---
APP_URL=http://localhost:3000
APP_NAME=Venn
MAPBOX_TOKEN=                               # unused: map uses MapLibre + OpenFreeMap (no token)

# "Continue with LinkedIn" (optional; button shows "Coming soon" until both are set).
# linkedin.com/developers → Create app → Products: "Sign In with LinkedIn using OpenID Connect".
# Auth tab → Authorized redirect URL: <APP_URL>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
